{
    "name": "phil/webskeleton",
    "description": "The base of a Symfony site: French and English, DDD layers, the PHIL UX kit, security headers, legal pages, contact form, sitemap, tests and quality gates.",
    "license": "MIT",
    "type": "project",
    "keywords": [
        "ddd",
        "multilingual",
        "php",
        "project-template",
        "site-skeleton",
        "symfony",
        "web-application"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://ph-il.ca",
            "role": "Maintainer"
        },
        {
            "name": "COil (Strangebuzz)",
            "homepage": "https://www.strangebuzz.com",
            "role": "Author of strangebuzz/microsymfony, on which WebSymfony and WebSkeleton are built"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-simplexml": "*",
        "ext-xml": "*",
        "doctrine/dbal": "^4.6",
        "doctrine/doctrine-bundle": "^3.4",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/migrations": "^3.10",
        "doctrine/orm": "^3.8",
        "doctrine/persistence": "^4.2",
        "easycorp/easyadmin-bundle": "^5.10",
        "phil/accessibility-statement-bundle": "^0.1.1@alpha",
        "phil/browser-security-bundle": "^0.2.1@alpha",
        "phil/circuit-breaker-bundle": "^0.2@alpha",
        "phil/contact-form-bundle": "^0.1.3@alpha",
        "phil/cors-bundle": "^0.1@alpha",
        "phil/ddd-bundle": "^0.1.1@alpha",
        "phil/doctrine-behaviours": "^0.3.1@alpha",
        "phil/doctrine-behaviours-bundle": "^0.3@alpha",
        "phil/error-tracking-bundle": "^0.1.1@alpha",
        "phil/feature-flags-bundle": "^0.1.2@alpha",
        "phil/legal-notices-bundle": "^0.1.1@alpha",
        "phil/menu-bundle": "^0.1.1@alpha",
        "phil/monitoring-bundle": "^0.1.1@alpha",
        "phil/privacy-bundle": "^0.4@alpha",
        "phil/sitemap": "^0.1.1@alpha",
        "phil/sitemap-bundle": "^0.1.1@alpha",
        "phil/spam-protection-bundle": "^0.3.1@alpha",
        "phil/structured-data-bundle": "^0.1@alpha",
        "phil/ux-bundle": "^0.1.2@alpha",
        "phil/ux-css": "^0.6@alpha",
        "phil/ux-easyadmin-bundle": "^0.1.1@alpha",
        "phil/ux-kit": "^0.7@alpha",
        "phil/well-known-bundle": "^0.1.1@alpha",
        "psr/log": "^3.0",
        "symfony/asset": "~8.2.0",
        "symfony/asset-mapper": "~8.2.0",
        "symfony/clock": "~8.2.0",
        "symfony/console": "~8.2.0",
        "symfony/dependency-injection": "~8.2.0",
        "symfony/doctrine-bridge": "~8.2.0",
        "symfony/dotenv": "~8.2.0",
        "symfony/flex": "^2.12",
        "symfony/form": "~8.2.0",
        "symfony/framework-bundle": "~8.2.0",
        "symfony/http-client": "~8.2.0",
        "symfony/http-foundation": "~8.2.0",
        "symfony/http-kernel": "~8.2.0",
        "symfony/intl": "~8.2.0",
        "symfony/lock": "~8.2.0",
        "symfony/mailer": "~8.2.0",
        "symfony/messenger": "~8.2.0",
        "symfony/monolog-bundle": "^4.1",
        "symfony/options-resolver": "~8.2.0",
        "symfony/password-hasher": "~8.2.0",
        "symfony/rate-limiter": "~8.2.0",
        "symfony/routing": "~8.2.0",
        "symfony/runtime": "~8.2.0",
        "symfony/security-bundle": "~8.2.0",
        "symfony/security-core": "~8.2.0",
        "symfony/security-csrf": "~8.2.0",
        "symfony/security-http": "~8.2.0",
        "symfony/stimulus-bundle": "^3.8",
        "symfony/string": "~8.2.0",
        "symfony/translation": "~8.2.0",
        "symfony/twig-bundle": "~8.2.0",
        "symfony/uid": "~8.2.0",
        "symfony/ux-turbo": "^3.8",
        "symfony/ux-twig-component": "^3.8",
        "symfony/validator": "~8.2.0",
        "symfony/web-link": "~8.2.0",
        "symfony/yaml": "~8.2.0",
        "twig/extra-bundle": "^3.31",
        "twig/intl-extra": "^3.31",
        "twig/twig": "^3.31"
    },
    "require-dev": {
        "bamarni/composer-bin-plugin": "^1.9",
        "brianium/paratest": "^7.30",
        "ergebnis/phpunit-slow-test-detector": "^2.29",
        "phil/accessibility-check": "^0.1.2@alpha",
        "phil/dev-tools": "^0.2.1@alpha",
        "phpunit/phpunit": "^13.4",
        "shipmonk/composer-dependency-analyser": "^1.8",
        "symfony/browser-kit": "~8.2.0",
        "symfony/css-selector": "~8.2.0",
        "symfony/debug-bundle": "~8.2.0",
        "symfony/http-client-contracts": "^3.6",
        "symfony/maker-bundle": "^1.68",
        "symfony/requirements-checker": "^2.0",
        "symfony/stopwatch": "~8.2.0",
        "symfony/web-profiler-bundle": "~8.2.0",
        "zenstruck/foundry": "^2.17"
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*",
        "symfony/polyfill-php85": "*"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../dev-tools",
            "options": {
                "symlink": true,
                "versions": {
                    "phil/dev-tools": "0.2.1-alpha"
                }
            }
        },
        {
            "type": "path",
            "url": "../phil/packages/cors-bundle",
            "options": {
                "symlink": true,
                "versions": {
                    "phil/cors-bundle": "0.1.0-alpha"
                }
            }
        }
    ],
    "minimum-stability": "alpha",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Fixtures\\": "fixtures/",
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "bamarni/composer-bin-plugin": true,
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "audit": {
            "abandoned": "fail",
            "block-insecure": true
        },
        "platform": {
            "php": "8.5.0"
        },
        "policy": {
            "advisories": {
                "block": true
            }
        },
        "process-timeout": 0,
        "sort-packages": true
    },
    "extra": {
        "bamarni-bin": {
            "bin-links": false,
            "forward-command": true,
            "target-directory": "vendor-bin"
        },
        "symfony": {
            "allow-contrib": true,
            "require": "8.2.*"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "requirements-checker": "script"
        }
    }
}
